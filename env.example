# База данных PostgreSQL
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=strongpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Mattermost интеграция
MATTERMOST_URL=https://your-mattermost.com
MATTERMOST_TOKEN=your-bot-token
CHANNEL_ID=your-channel-id
MENTION_USERS=@user1,@user2
ACK_URL=http://your-domain/hooks/mattermost/action/

# YouTrack интеграция
YOUTRACK_URL=https://your-youtrack.com
YOUTRACK_TOKEN=your-youtrack-token
YOUTRACK_PROJECT=YOUR-PROJECT

# SMS фильтрация
ALLOWED_NUMBER=+998937552558
ALLOWED_ACK_USER_IDS=user1,user2,user3

# Временная зона
TIME_ZONE=Asia/Tashkent

# Gammu настройки (для Docker worker)
INBOX_DIR=/var/spool/gammu/inbox
PROCESSED_DIR=/var/spool/gammu/processed
LOOP_INTERVAL=60
SLEEP_BETWEEN_FILES=0.5
MAX_PER_ITERATION=50
ERROR_BACKOFF=2